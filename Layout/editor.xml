<Screen>
  <Event type="keyDown" key="f1" action="MADSCORE\App\ControllerNavigation::openSettings" />
  <Event type="keyDown" key="escape" action="MADSCORE\App\ControllerComposer::closeComposerShortcut" />
  <Event type="keyDown" key="escape" action="MADSCORE\App\ControllerChords::closeChordShortcut" />
  <Event type="keyDown" key="escape" action="MADSCORE\App\Files::cancelShortcut" />
  <Event type="keyDown" key="escape" action="MADSCORE\App\ControllerNavigation::activateSheetEditor" />
  <Event type="keyDown" key="r" action="MADSCORE\App\ControllerNavigation::selectSettingsShortcut" />
  <Event type="keyDown" key="y" action="MADSCORE\App\ControllerNavigation::selectSettingsShortcut" />
  <Event type="keyDown" key="t" action="MADSCORE\App\ControllerNavigation::selectSettingsShortcut" />
  <Event type="keyDown" key="ctrl+z" action="MADSCORE\App\ControllerNoteEditing::undoScoreShortcut" />
  <Event type="keyDown" key="ctrl+y" action="MADSCORE\App\ControllerNoteEditing::redoScoreShortcut" />
  <Event type="keyDown" key="c" action="MADSCORE\App\ControllerComposer::openComposerShortcut" />
  <Event type="keyDown" key="shift+c" action="MADSCORE\App\ControllerMotifGeneration::regenerateComposerShortcut" />
  <Event type="keyDown" key="o" action="MADSCORE\App\ControllerChords::openChordShortcut" />
  <Event type="keyDown" key="shift+o" action="MADSCORE\App\ControllerChords::rerollChordShortcut" />
  <Event type="keyDown" key="v" action="MADSCORE\App\ControllerComposer::composerViewShortcut" />
  <Event type="keyDown" key="ctrl+*" action="MADSCORE\App\ControllerNoteEditing::melodyWedgeShortcut" />
  <Event type="keyDown" key="ctrl+shift+*" action="MADSCORE\App\ControllerNoteEditing::melodyWedgeShortcut" />
  <Event type="keyDown" key="ctrl+shift+8" action="MADSCORE\App\ControllerNoteEditing::melodyWedgeShortcut" />
  <Event type="keyDown" action="MADSCORE\App\ControllerNoteEditing::keypadMelodyWedgeShortcut" />
  <Layout direction="vertical">
    <Layout id="documentHeader" direction="horizontal" height="1">
      <Input id="title" width="3*">
        <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
      </Input>
      <Separator />
      <Input id="author" width="2*">
        <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
      </Input>
      <Separator />
      <Input id="catalog" width="16">
        <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
      </Input>
    </Layout>
    <Layout id="contextHeader" overwrite="#documentHeader" direction="horizontal" height="1">
      <Title id="contextId" width="18" navigate="false">Motif A</Title>
      <Separator />
      <Input id="contextName" width="2*">
        <Event type="accept" action="MADSCORE\App\ControllerMotifGeneration::contextNameAccepted" />
      </Input>
      <Separator />
      <Title id="contextInfo" width="2*" navigate="false"></Title>
    </Layout>
    <Separator />
    <Layout id="board" direction="horizontal" height="1*">
      <Empty navigate="false" />
    </Layout>
    <Separator />
    <Layout id="settingsPanel" direction="horizontal" height="19">
      <Layout id="barBox" direction="vertical" width="1*" navigateChildren="false" enterChildren="true">
        <Title id="barSettingsTitle" height="1" navigate="false">[R] Bar 1</Title>
        <Input id="tempo" height="2" label="Tempo (BPM)">
          <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
        </Input>
        <Input id="beats" height="2" label="Beats per bar">
          <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
        </Input>
        <Input id="barNote" height="2" label="Bar note">
          <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
        </Input>
        <Input id="repeats" height="2" label="Repeats (0–8)">
          <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
        </Input>
        <Button id="section" hotkey="|" label="Section start: Yes" action="MADSCORE\App\ControllerNavigation::functionButton" />
        <Empty height="0*" navigate="false" />
      </Layout>
      <Separator />
      <Layout id="melodyBox" direction="vertical" width="1*" navigateChildren="false" enterChildren="true">
        <Title id="selectedMelody" height="1" navigate="false">[Y] Melody 1</Title>
        <ColorInput id="color" height="auto" label="Color (#rrggbb)" value="#c04b20">
          <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
        </ColorInput>
        <Input id="sound" height="2" label="Sound" value="Acoustic Grand Piano">
          <Event type="activate" action="MADSCORE\App\ControllerEditorActions::showSoundPicker" />
        </Input>
        <Input id="volume" height="2" label="Volume (0–100%)" value="50">
          <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
        </Input>
        <Text id="melodyHelp" height="4" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">Tab Next
Shift+Tab Previous
N New melody
CTRL+Z/Y Undo/Redo</Text>
        <Button id="muteMelody" hotkey="0" label="Mute: No" action="MADSCORE\App\ControllerNavigation::toggleMelodyMute" />
        <Button id="deleteMelody" label="Delete melody" action="MADSCORE\App\ControllerNavigation::requestDeleteMelody" />
        <Empty height="0*" navigate="false" />
        <List id="soundPicker" overwrite="#noteBox" title="Sound" filterable="true" searchable="true" height="1*">
          <Item value="gm:0" selected="true">Acoustic Grand Piano</Item>
          <Event type="accept" action="MADSCORE\App\ControllerEditorActions::melodyPatternChanged" />
        </List>
      </Layout>
      <Separator />
      <Layout id="noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true" initialFocus="figure">
        <Title id="noteTitle" height="1" navigate="false">[T] Note · [C] Composer · [O] Chord</Title>
        <Layout direction="horizontal" height="1*">
          <Layout direction="vertical" width="1*">
            <Title id="currentNoteTitle" height="1" navigate="false">Gap</Title>
            <Button id="trill" hotkey="w" label="Trill: Off" action="MADSCORE\App\ControllerNavigation::functionButton" />
            <Button id="staccato" hotkey="s" label="Staccato: No" action="MADSCORE\App\ControllerNavigation::functionButton" />
            <Button id="fermata" hotkey="h" label="Fermata: No" action="MADSCORE\App\ControllerNavigation::functionButton" />
            <Button id="slur" hotkey="l" label="Link to next: No" action="MADSCORE\App\ControllerNavigation::functionButton" />
            <Button id="glissando" hotkey="\" label="Glissando: No" action="MADSCORE\App\ControllerNavigation::functionButton" />
            <Button id="dynamic" hotkey="*" label="All wedge: =" action="MADSCORE\App\ControllerNavigation::functionButton" />
            <Button id="dynamicLevel" hotkey="/" label="All levels: —" action="MADSCORE\App\ControllerNavigation::functionButton" />
            <Empty height="0*" navigate="false" />
          </Layout>
          <Layout direction="vertical" width="1*">
            <Input id="finger" height="2" label="Finger (L/R1–5)">
              <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
            </Input>
            <Input id="figure" height="2" label="Figure" tip="OA-OZ ornament, TA-TZ tuplet motif, or +middle+last semitones (e.g. +2-1). Optional separators are accepted.">
              <Event type="accept" action="MADSCORE\App\ControllerEditorActions::editorFieldAccepted" />
            </Input>
            <Text id="noteHelp" height="9" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">Space Add/follow
Return Add/change
1-9 All ppp-fff
CTRL+1-9 ppp-fff
U Duplicate
Ins Insert beat
Bksp Delete + gap
Del Delete note/gap
CTRL+* Melody wedge</Text>
            <Empty height="0*" navigate="false" />
          </Layout>
        </Layout>
      </Layout>
      <Layout id="exportPanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title navigate="false">Export formats</Title>
        <List id="exportFormats" multiple="true" filterable="false" searchable="false" height="1*">
          <Item value="midi" selected="true">MIDI (.mid)</Item>
          <Item value="musicxml">MusicXML (.musicxml)</Item>
          <Item value="pdf" selected="true">PDF (.pdf)</Item>
          <Item value="wav">WAV (.wav)</Item>
        </List>
        <Button id="exportSelected" label="Export selected" action="MADSCORE\App\ControllerEditorActions::exportSelected" />
      </Layout>
      <Layout id="composerPanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title navigate="false">Motif composer</Title>
        <Input id="composerItem" height="2" label="Current motif">
          <Event type="activate" action="MADSCORE\App\ControllerComposer::showComposerItems" />
        </Input>
        <Button id="composerToScore" hotkey="s" label="Score mode" action="MADSCORE\App\ControllerComposer::composerSwitchScore" />
        <Button id="composerOpenGenerate" hotkey="g" label="Generate new" action="MADSCORE\App\ControllerComposer::showGenerateComposer" />
        <Button id="composerAddVersion" hotkey="v" label="Derive version" action="MADSCORE\App\ControllerMotifGeneration::showMotifVersionPicker" />
        <Button id="motifSectionKey" hotkey="k" label="Key" action="MADSCORE\App\ControllerComposer::showSectionKey" />
        <Empty height="0*" navigate="false" />
      </Layout>
      <Layout id="composerGeneratePanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title id="composerGenerateTitle" navigate="false">Source: none → Target: A</Title>
        <Input id="composerBeats" height="2" label="Length (3–32 beats)" value="4" />
        <Input id="composerNotes" height="2" label="Pitches to use (1–7)" value="4" />
        <Button id="composerType" label="Type: Random step" action="MADSCORE\App\ControllerComposer::showComposerTypePicker" />
        <Button id="composerScale" label="Scale: Random" action="MADSCORE\App\ControllerComposer::showComposerScalePicker" />
        <Button id="composerHomeNote" label="Home note: Random" action="MADSCORE\App\ControllerComposer::showComposerHomeNotePicker" />
        <Button id="composerGenerate" label="Generate" action="MADSCORE\App\ControllerComposer::generateComposer" />
        <Empty height="0*" navigate="false" />
      </Layout>
      <Layout id="composerScorePanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title navigate="false">Score composer</Title>
        <TextEditor id="scorePattern" height="1*" textWrap="true" label="Motif pattern">Create motifs first. Then replace this text with the list of motifs. Use this format: 'A B A1 | A B1 A2'. Then press the build button.</TextEditor>
        <Layout direction="horizontal" height="1">
          <Button id="scoreToMotif" width="1*" hotkey="m" label="Motif editor" action="MADSCORE\App\ControllerComposer::composerSwitchMotif" />
          <Button id="scoreBuild" width="1*" hotkey="b" label="Build score" action="MADSCORE\App\ControllerComposer::requestBuildScore" />
          <Button id="scoreSectionKey" width="1*" hotkey="k" label="Key" action="MADSCORE\App\ControllerComposer::showSectionKey" />
        </Layout>
      </Layout>
      <Layout id="sectionKeyPanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title id="sectionKeyTitle" navigate="false">Key</Title>
        <Button id="sectionKeyScale" label="Scale: Major" action="MADSCORE\App\ControllerComposer::showSectionScalePicker" />
        <Button id="sectionKeyHomeNote" label="Home note: C" action="MADSCORE\App\ControllerComposer::showSectionHomeNotePicker" />
        <Button id="sectionKeySet" label="Set key" action="MADSCORE\App\ControllerComposer::setSectionKey" />
        <Button id="sectionKeyClear" label="Clear key" action="MADSCORE\App\ControllerComposer::clearSectionKey" />
        <Empty height="0*" navigate="false" />
      </Layout>
      <List id="sectionScalePicker" overwrite="#noteBox" title="Scale" filterable="false" searchable="false" width="2*">
        <Item value="Major" selected="true">Major</Item>
        <Item value="Dorian">Dorian</Item>
        <Item value="Phrygian">Phrygian</Item>
        <Item value="Lydian">Lydian</Item>
        <Item value="Mixolydian">Mixolydian</Item>
        <Item value="Minor">Minor</Item>
        <Item value="Locrian">Locrian</Item>
        <Event type="accept" action="MADSCORE\App\ControllerComposer::acceptSectionScale" />
      </List>
      <List id="sectionHomeNotePicker" overwrite="#noteBox" title="Home note" filterable="false" searchable="false" width="2*">
        <Item value="C" selected="true">C</Item>
        <Item value="C#">C#</Item>
        <Item value="D">D</Item>
        <Item value="D#">D#</Item>
        <Item value="E">E</Item>
        <Item value="F">F</Item>
        <Item value="F#">F#</Item>
        <Item value="G">G</Item>
        <Item value="G#">G#</Item>
        <Item value="A">A</Item>
        <Item value="A#">A#</Item>
        <Item value="B">B</Item>
        <Event type="accept" action="MADSCORE\App\ControllerComposer::acceptSectionHomeNote" />
      </List>
      <Layout id="chordPanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title id="chordTitle" navigate="false">Chord generator</Title>
        <Layout direction="horizontal" height="2">
          <Input id="chordNotes" width="1*" label="Notes (2–7)" value="3" />
          <Input id="chordSeries" width="1*" label="Number (1–16)" value="1" />
        </Layout>
        <Layout direction="horizontal" height="2">
          <Input id="chordDegree" width="1*" label="Degree (1–7/random)" value="random" />
          <Input id="chordInversion" width="1*" label="Inversion (0–6/random)" value="random" />
        </Layout>
        <Layout direction="horizontal" height="2">
          <Button id="chordScale" width="1*" label="Scale: Choose" action="MADSCORE\App\ControllerChords::showChordScalePicker" />
          <Button id="chordHomeNote" width="1*" label="Home note: Choose" action="MADSCORE\App\ControllerChords::showChordHomeNotePicker" />
        </Layout>
        <Button id="chordMode" label="Place in: Separate melodies" action="MADSCORE\App\ControllerChords::toggleChordMode" />
        <Button id="chordGenerate" label="Place chord(s)" action="MADSCORE\App\ControllerChords::generateChords" />
        <Empty height="0*" navigate="false" />
      </Layout>
      <List id="chordScalePicker" overwrite="#noteBox" title="Scale" filterable="false" searchable="false" width="2*">
        <Item value="Major" selected="true">Major</Item>
        <Item value="Dorian">Dorian</Item>
        <Item value="Phrygian">Phrygian</Item>
        <Item value="Lydian">Lydian</Item>
        <Item value="Mixolydian">Mixolydian</Item>
        <Item value="Minor">Minor</Item>
        <Item value="Locrian">Locrian</Item>
        <Event type="accept" action="MADSCORE\App\ControllerChords::acceptChordScale" />
      </List>
      <List id="chordHomeNotePicker" overwrite="#noteBox" title="Home note" filterable="false" searchable="false" width="2*">
        <Item value="C" selected="true">C</Item>
        <Item value="C#">C#</Item>
        <Item value="D">D</Item>
        <Item value="D#">D#</Item>
        <Item value="E">E</Item>
        <Item value="F">F</Item>
        <Item value="F#">F#</Item>
        <Item value="G">G</Item>
        <Item value="G#">G#</Item>
        <Item value="A">A</Item>
        <Item value="A#">A#</Item>
        <Item value="B">B</Item>
        <Event type="accept" action="MADSCORE\App\ControllerChords::acceptChordHomeNote" />
      </List>
      <List id="composerItems" overwrite="#noteBox" title="Items" filterable="false" searchable="false" width="2*">
        <Item value="main">Main</Item>
        <Event type="accept" action="MADSCORE\App\ControllerComposer::acceptComposerItem" />
      </List>
      <Layout id="motifVersionPicker" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title id="motifVersionSourceTarget" navigate="false">Source: A → Target: A1</Title>
        <List id="motifVersionList" height="1*" title="Version algorithm" filterable="false" searchable="false">
          <Item value="keep-opening">Keep opening, new ending</Item>
          <Item value="new-ending">Change last notes</Item>
          <Item value="transpose">Transpose in scale</Item>
          <Item value="invert">Invert pitch contour</Item>
          <Item value="reverse">Reverse pitches</Item>
          <Item value="rhythm">Move half-beat splits</Item>
          <Event type="accept" action="MADSCORE\App\ControllerMotifGeneration::acceptMotifVersionAlgorithm" />
        </List>
      </Layout>
      <Layout id="motifVersionParams" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title id="motifVersionParamsSourceTarget" navigate="false">Source: A → Target: A1</Title>
        <Title id="motifVersionTitle" navigate="false">Version parameters</Title>
        <Input id="motifVersionValue" height="2" label="Value" value="1" />
        <Button id="motifVersionCreate" label="Create version" action="MADSCORE\App\ControllerMotifGeneration::createMotifVersion" />
        <Empty height="0*" navigate="false" />
      </Layout>
      <List id="composerTypePicker" overwrite="#noteBox" title="Generator type" filterable="false" searchable="false" width="2*">
        <Item value="random-step" selected="true">Random step</Item>
        <Item value="up-wave">Up wave</Item>
        <Item value="down-wave">Down wave</Item>
        <Item value="alternating">Alternating low and high</Item>
        <Item value="skipping">Skipping notes</Item>
        <Event type="accept" action="MADSCORE\App\ControllerComposer::acceptComposerType" />
      </List>
      <List id="composerScalePicker" overwrite="#noteBox" title="Scale" filterable="false" searchable="false" width="2*">
        <Item value="random" selected="true">Random</Item>
        <Item value="Major">Major</Item>
        <Item value="Dorian">Dorian</Item>
        <Item value="Phrygian">Phrygian</Item>
        <Item value="Lydian">Lydian</Item>
        <Item value="Mixolydian">Mixolydian</Item>
        <Item value="Minor">Minor</Item>
        <Item value="Locrian">Locrian</Item>
        <Event type="accept" action="MADSCORE\App\ControllerComposer::acceptComposerScale" />
      </List>
      <List id="composerHomeNotePicker" overwrite="#noteBox" title="Home note" filterable="false" searchable="false" width="2*">
        <Item value="random" selected="true">Random</Item>
        <Item value="C">C</Item>
        <Item value="C#">C#</Item>
        <Item value="D">D</Item>
        <Item value="D#">D#</Item>
        <Item value="E">E</Item>
        <Item value="F">F</Item>
        <Item value="F#">F#</Item>
        <Item value="G">G</Item>
        <Item value="G#">G#</Item>
        <Item value="A">A</Item>
        <Item value="A#">A#</Item>
        <Item value="B">B</Item>
        <Event type="accept" action="MADSCORE\App\ControllerComposer::acceptComposerHomeNote" />
      </List>
      <Layout id="savePanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title navigate="false">Save project</Title>
        <FileSelector id="saveDirectory" height="1*" filterable="false" searchable="false">
          <Event type="change" action="MADSCORE\App\Files::directoryChanged" />
        </FileSelector>
        <Input id="saveFilename" height="2" label="File name (.json.gz)" value="score.json.gz" />
        <Layout direction="horizontal" height="1">
          <Button id="confirmSave" label="Save" action="MADSCORE\App\Files::saveAs" />
          <Empty width="1*" navigate="false" />
        </Layout>
      </Layout>
      <Layout id="loadPanel" overwrite="#noteBox" direction="vertical" width="2*" navigateChildren="false" enterChildren="true">
        <Title navigate="false">Load project or MusicXML</Title>
        <FileSelector id="loadSelector" height="1*" filterable="false" searchable="false">
          <Event type="change" action="MADSCORE\App\Files::directoryChanged" />
          <Event type="keyDown" key="enter" action="MADSCORE\App\Files::open" />
        </FileSelector>
        <Layout direction="horizontal" height="1">
          <Button id="confirmLoad" label="Load" action="MADSCORE\App\Files::open" />
          <Button id="newScore" label="New" action="MADSCORE\App\Files::createNew" />
          <Empty width="1*" navigate="false" />
        </Layout>
      </Layout>
      <Separator />
      <Layout id="cursorBox" direction="vertical" width="1*" navigateChildren="false">
        <Title id="cursorTitle" height="1" navigate="false">Cursor C4</Title>
        <Text id="cursorLength" height="1" navigate="false">Length 1 beat</Text>
        <Text id="cursorHelp" height="10" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">Left/Right Time
Up/Down Pitch/±1
Home/End Edge
CTRL+Home/End All
PgUp/Down Oct/±12
Shift+Move Range
CTRL+Shift All
CTRL+A Select all
+/- Change length</Text>
        <Empty height="0*" navigate="false" />
      </Layout>
      <Separator />
      <Layout id="actionsBox" direction="vertical" width="1*" navigateChildren="false" enterChildren="true">
        <Title navigate="false">Actions</Title>
        <Text id="actionsHelp" height="5" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">P/M Play all/one
V Preview
C Composer
O Chords
CTRL+C/V Copy/Paste</Text>
        <Button id="saveButton" hotkey="ctrl+s" label="Save as" action="MADSCORE\App\ControllerEditorActions::saveDialog" />
        <Button id="writeButton" hotkey="ctrl+w" label="Write" action="MADSCORE\App\ControllerEditorActions::write" />
        <Button id="loadButton" hotkey="ctrl+o" label="Load" action="MADSCORE\App\ControllerEditorActions::loadDialog" />
        <Button id="exportButton" hotkey="ctrl+e" label="Export" action="MADSCORE\App\ControllerEditorActions::exportDialog" />
        <Button id="settingsButton" hotkey="f1" label="Settings" action="MADSCORE\App\ControllerNavigation::openSettings" />
        <Empty height="0*" navigate="false" />
      </Layout>
    </Layout>
    <Separator />
    <StatusBar height="1" />
  </Layout>
</Screen>
