<Screen>
  <Event type="keyDown" key="f1" action="MADSCORE\App\Controller::openSettings" />
  <Event type="keyDown" key="escape" action="MADSCORE\App\Files::cancelShortcut" />
  <Event type="keyDown" key="escape" action="MADSCORE\App\Controller::activateSheetEditor" />
  <Event type="keyDown" key="ctrl+z" action="MADSCORE\App\Controller::undoMelodyShortcut" />
  <Event type="keyDown" key="ctrl+y" action="MADSCORE\App\Controller::redoMelodyShortcut" />
  <Event type="keyDown" key="ctrl+*" action="MADSCORE\App\Controller::melodyWedgeShortcut" />
  <Event type="keyDown" key="ctrl+shift+*" action="MADSCORE\App\Controller::melodyWedgeShortcut" />
  <Event type="keyDown" key="ctrl+shift+8" action="MADSCORE\App\Controller::melodyWedgeShortcut" />
  <Event type="keyDown" action="MADSCORE\App\Controller::keypadMelodyWedgeShortcut" />
  <Layout direction="vertical">
    <Layout direction="horizontal" height="1">
      <Input id="title" width="3*">
        <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
      </Input>
      <Separator />
      <Input id="author" width="2*">
        <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
      </Input>
      <Separator />
      <Input id="catalog" width="16">
        <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
      </Input>
    </Layout>
    <Separator />
    <Layout id="board" direction="horizontal" height="1*">
      <Empty navigate="false" />
    </Layout>
    <Separator />
    <Layout id="settingsPanel" direction="horizontal" height="19">
      <Layout direction="vertical" width="2*">
        <Title id="barSettingsTitle" height="1" navigate="false">[R] Bar 1</Title>
        <Input id="tempo" height="2" label="Tempo (BPM)">
          <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
        </Input>
        <Input id="beats" height="2" label="Beats per bar">
          <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
        </Input>
        <Input id="barNote" height="2" label="Bar note">
          <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
        </Input>
        <Input id="repeats" height="2" label="Repeats (0–8)">
          <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
        </Input>
        <Button id="section" hotkey="|" label="Section start: Yes" action="MADSCORE\App\Controller::functionButton" />
        <Empty height="0*" navigate="false" />
      </Layout>
      <Separator />
      <Layout id="melodyBox" direction="vertical" width="2*">
        <Title id="selectedMelody" height="1" navigate="false">[Y] Melody 1</Title>
        <ColorInput id="color" height="auto" label="Color (#rrggbb)" value="#c04b20">
          <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
        </ColorInput>
        <Input id="sound" height="2" label="Sound" value="Organ">
          <Event type="activate" action="MADSCORE\App\Controller::showSoundPicker" />
        </Input>
        <Input id="volume" height="2" label="Volume (0–100%)">
          <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
        </Input>
        <Text id="melodyHelp" height="4" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">Tab Next
Shift+Tab Previous
N New melody
CTRL+Z/Y Undo/Redo</Text>
        <Button id="muteMelody" hotkey="0" label="Mute: No" action="MADSCORE\App\Controller::toggleMelodyMute" />
        <Button id="deleteMelody" label="Delete melody" action="MADSCORE\App\Controller::requestDeleteMelody" />
        <Empty height="0*" navigate="false" />
        <List id="soundPicker" overwrite="#noteBox" title="Sound" filterable="true" searchable="true" height="1*">
          <Item value="gm:19" selected="true">Church Organ</Item>
          <Event type="accept" action="MADSCORE\App\Controller::melodyPatternChanged" />
        </List>
      </Layout>
      <Separator />
      <Layout id="noteBox" direction="vertical" width="5*">
        <Title id="noteTitle" height="1" navigate="false">[T] Gap</Title>
        <Layout direction="horizontal" height="1*">
          <Layout direction="vertical" width="1*">
            <Button id="trill" hotkey="w" label="Trill: Off" action="MADSCORE\App\Controller::functionButton" />
            <Button id="staccato" hotkey="s" label="Staccato: No" action="MADSCORE\App\Controller::functionButton" />
            <Button id="fermata" hotkey="h" label="Fermata: No" action="MADSCORE\App\Controller::functionButton" />
            <Button id="slur" hotkey="l" label="Link to next: No" action="MADSCORE\App\Controller::functionButton" />
            <Button id="glissando" hotkey="\" label="Glissando: No" action="MADSCORE\App\Controller::functionButton" />
            <Button id="dynamic" hotkey="*" label="All wedge: =" action="MADSCORE\App\Controller::functionButton" />
            <Button id="dynamicLevel" hotkey="/" label="All levels: —" action="MADSCORE\App\Controller::functionButton" />
            <Empty height="0*" navigate="false" />
          </Layout>
          <Layout direction="vertical" width="1*">
            <Input id="finger" height="2" label="Finger (L/R1–5)">
              <Event type="accept" action="MADSCORE\App\Controller::editorFieldAccepted" />
            </Input>
            <Text id="noteHelp" height="9" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">Space Add/follow
Return Add/change
1-9 All ppp-fff
CTRL+1-9 ppp-fff
U Duplicate
Ins Insert beat
Bksp Delete + gap
Del Delete note/gap
CTRL+* Melody wedge</Text>
            <Empty height="0*" navigate="false" />
          </Layout>
        </Layout>
      </Layout>
      <Layout id="savePanel" overwrite="#noteBox" direction="vertical" width="5*">
        <Title navigate="false">Save score</Title>
        <FileSelector id="saveDirectory" height="1*" filterable="false" searchable="false">
          <Event type="change" action="MADSCORE\App\Files::directoryChanged" />
        </FileSelector>
        <Input id="saveFilename" height="2" label="File name (.json)" value="score.json" />
        <Layout direction="horizontal" height="1">
          <Button id="confirmSave" label="Save" action="MADSCORE\App\Files::saveAs" />
          <Button id="cancelSave" label="Cancel" action="MADSCORE\App\Files::cancel" />
          <Empty width="1*" navigate="false" />
        </Layout>
      </Layout>
      <Layout id="loadPanel" overwrite="#noteBox" direction="vertical" width="5*">
        <Title navigate="false">Load score</Title>
        <FileSelector id="loadSelector" height="1*" filterable="false" searchable="false">
          <Event type="change" action="MADSCORE\App\Files::directoryChanged" />
          <Event type="keyDown" key="enter" action="MADSCORE\App\Files::open" />
        </FileSelector>
        <Layout direction="horizontal" height="1">
          <Button id="confirmLoad" label="Load" action="MADSCORE\App\Files::open" />
          <Button id="newScore" label="New" action="MADSCORE\App\Files::createNew" />
          <Button id="cancelLoad" label="Cancel" action="MADSCORE\App\Files::cancel" />
          <Empty width="1*" navigate="false" />
        </Layout>
      </Layout>
      <Layout id="cursorBox" direction="vertical" width="2*" navigateChildren="false">
        <Title id="cursorTitle" height="1" navigate="false">Cursor C4</Title>
        <Text id="cursorLength" height="1" navigate="false">Length 1 beat</Text>
        <Text id="cursorHelp" height="10" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">Left/Right Time
Up/Down Pitch/±1
Home/End Edge
CTRL+Home/End All
PgUp/Down Oct/±12
Shift+Move Range
CTRL+Shift All
CTRL+A Select all
+/- Change length</Text>
        <Empty height="0*" navigate="false" />
      </Layout>
      <Separator />
      <Layout id="actionsBox" direction="vertical" width="2*">
        <Title navigate="false">Actions</Title>
        <Text id="actionsHelp" height="5" navigate="false" highlighter="MADSCORE\App\HelpHighlighter">P/M Play all/one
V Preview
CTRL+C/V Copy/Paste</Text>
        <Button id="saveButton" hotkey="ctrl+s" label="Save as" action="MADSCORE\App\Controller::saveDialog" />
        <Button id="writeButton" hotkey="ctrl+w" label="Write" action="MADSCORE\App\Controller::write" />
        <Button id="loadButton" hotkey="ctrl+o" label="Load" action="MADSCORE\App\Controller::loadDialog" />
        <Button id="exportPdfButton" hotkey="ctrl+e" label="Export PDF" action="MADSCORE\App\Controller::exportPdf" />
        <Button id="exportMidiButton" hotkey="ctrl+m" label="Export MIDI" action="MADSCORE\App\Controller::exportMidi" />
        <Button id="settingsButton" hotkey="f1" label="Settings" action="MADSCORE\App\Controller::openSettings" />
        <Empty height="0*" navigate="false" />
      </Layout>
    </Layout>
    <Separator />
    <StatusBar height="1" />
  </Layout>
</Screen>
