<Screen>
  <Layout direction="vertical">
    <Title height="1" navigate="false">Files</Title>
    <Input id="path" height="2" label="Score path (.json)" />
    <Input id="legacy" height="2" label="Legacy source path (.txt)" />
    <Input id="pdf" height="2" label="PDF path" />
    <Layout direction="horizontal" height="1">
      <Button label="Open" action="MADSCORE\App\Controller::open" />
      <Button label="Save as" action="MADSCORE\App\Controller::saveAs" />
      <Button label="Import" action="MADSCORE\App\Controller::importLegacy" />
      <Button label="Export PDF" action="MADSCORE\App\Controller::exportPdf" />
      <Button label="Back" action="MADSCORE\App\Controller::showEditor" />
    </Layout>
    <Text id="importWarnings" height="4" navigate="false">Legacy import warnings appear here.</Text>
    <Empty height="1*" navigate="false" />
    <StatusBar height="1" />
  </Layout>
</Screen>
