<Screen>
  <Event type="keyDown" key="escape" action="MADSCORE\App\ControllerNavigation::closeSettings" />
  <Event type="keyDown" key="f1" action="MADSCORE\App\Settings::openTutorial" />
  <Layout direction="vertical">
    <Title height="1">madscore — settings and about</Title>
    <Separator />
    <Layout direction="horizontal" height="1*">
      <Layout width="40">
        <Image src="../Assets/logo.png" fit="contain" interactive="false" />
        <Separator />
        <Input id="defaultDirectory" height="2" label="Default directory" tip="Used when a file selector first opens. Changes are saved as you type." />
        <Button id="playbackSound" label="Playback: MIDI" action="MADSCORE\App\ControllerPlayback::togglePlaybackSound" />
        <Button id="tristaffTutorial" label="Tristaff tutorial" hotkey="f1" action="MADSCORE\App\Settings::openTutorial" />
        <Empty height="1*" navigate="false" />
        <Button id="settingsBack" label="Back to score" hotkey="escape" action="MADSCORE\App\ControllerNavigation::closeSettings" />
        <Button id="settingsExit" label="Exit" hotkey="q" action="MADSCORE\App\ControllerNavigation::quit" />
      </Layout>
      <Separator />
      <Layout width="1*">
        <Text title="About madscore" height="5">madscore is a tile based score editor for Tristaff notation. Write melodies, preview pages, and export scores as PDF or MIDI.
Use F1 to read the Tristaff tutorial.</Text>
        <Separator />
        <Text id="settingsUnlicense" title="Unlicense" height="1*" />
      </Layout>
    </Layout>
    <Separator />
    <StatusBar height="1" />
  </Layout>
</Screen>
