<App font="LiberationMono-Bold" fontSize="17">
  <Event type="init" action="MADSCORE\App\Controller::initialize" />
  <Event type="close" action="MADSCORE\App\Controller::persistSession" />
  <Event type="resize" action="MADSCORE\App\Controller::resize" />
  <Window title="madscore" width="120" height="38" mode="maximized">
    <Screen id="editor" title="Score" file="editor.xml" />
    <Screen id="sheet" title="PDF preview" file="sheet.xml" />
    <Screen id="files" title="Files" file="files.xml" />
  </Window>
</App>
